# --- Базовые настройки приложения ---
APP_NAME="Обещание против реальности"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Секрет для подписи токенов сессий. ОБЯЗАТЕЛЬНО замените в рабочей среде.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-secret

# --- База данных (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://oapv_app:oapv_local_dev@localhost:5432/obeshchanie
DATABASE_ECHO=false

# --- Хранилище загруженных файлов ---
# Файлы сохраняются под сгенерированными именами в отдельной папке.
STORAGE_DIR=app/backend/var/storage

# --- Ограничения загрузки ---
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.txt,.csv,.md,.pdf,.xlsx

# --- Демо-режим ---
DEMO_MODE=true
DEMO_WORKSPACE_NAME="Демонстрационное пространство"
DEMO_USER_EMAIL=demo@local.test
DEMO_USER_PASSWORD=demo12345

# --- ИИ-провайдер ---
# mock            — локальная эвристика, без сети (по умолчанию)
# ollama          — локальная модель с открытыми весами через Ollama
# openai_compatible — любой OpenAI-совместимый API (нужен ключ)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# --- CORS (frontend Vite) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Прочее ---
TOKEN_TTL_HOURS=336
RULES_VERSION=rules-2024.1

# --- Контейнерный запуск (Podman) ---
# Эти переменные использует compose.yaml. Значения по умолчанию заданы там же;
# переопределите их в окружении PowerShell перед `podman compose up`.
# ВАЖНО: DATABASE_URL из этого файла в контейнеры НЕ попадает —
# внутри сети адрес базы всегда db:5432 (см. docs/PODMAN_SETUP.md).
POSTGRES_USER=oapv
POSTGRES_PASSWORD=oapv_container_local
POSTGRES_DB=obeshchanie
DB_HOST_PORT=55432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
