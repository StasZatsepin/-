# Пример конфигурации проекта (скопируйте в .env и настройте под себя).
# Файл .env не попадает в Git.

# --- Базовые настройки приложения ---
APP_NAME="Обещание против реальности"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Секрет для подписи токенов сессий. ОБЯЗАТЕЛЬНО замените в рабочей среде.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-change-in-production

# --- База данных (PostgreSQL) ---
# Локально: postgresql+psycopg://user:pass@localhost:5432/obeshchanie
# Render + Neon: pooled connection string от Neon (см. ниже)
DATABASE_URL=postgresql+psycopg://oapv_app:oapv_local_dev@localhost:5432/obeshchanie
DATABASE_ECHO=false

# --- Хранилище загруженных файлов ---
# Локально: папка в проекте
# Render: /tmp/storage (непостоянное, файлы пропадут при редеплое)
STORAGE_DIR=app/backend/var/storage

# --- Ограничения загрузки ---
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.txt,.csv,.md,.pdf,.xlsx

# --- Демо-режим ---
DEMO_MODE=true
DEMO_WORKSPACE_NAME="Демонстрационное пространство"
DEMO_USER_EMAIL=demo@local.test
DEMO_USER_PASSWORD=demo12345

# --- ИИ-провайдер ---
# mock            — локальная эвристика, без сети (по умолчанию)
# ollama          — локальная модель с открытыми весами через Ollama
# openai_compatible — любой OpenAI-совместимый API (нужен ключ)
# openrouter      — бесплатные модели OpenRouter (нужен ключ)
LLM_PROVIDER=mock

LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# --- Ollama: локальные модели ---
# Адрес сервера Ollama.
# При запуске backend на Windows: http://localhost:11434 (WSL2 пробрасывает порт автоматически).
# При запуске backend в Podman-контейнере: уточните адрес хоста (host.docker.internal может не разрешаться на Windows без Docker Desktop).
# IP WSL (например, http://172.22.97.21:11434) может измениться после перезапуска — используйте localhost, если возможно.
OLLAMA_BASE_URL=http://localhost:11434
# Идентификатор модели из `ollama list`
OLLAMA_MODEL=qwen2.5:3b
# Таймаут запроса к Ollama (секунды). На CPU без GPU модель медленная.
OLLAMA_TIMEOUT_SECONDS=300

# --- CORS ---
# Локально: http://localhost:5173,http://127.0.0.1:5173
# Render: публичный URL frontend (например, https://obeshchanie-frontend.onrender.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Прочее ---
TOKEN_TTL_HOURS=336
RULES_VERSION=rules-2024.1

# --- OpenRouter: бесплатные модели (резервный провайдер, не обязателен) ---
# Ключ создаётся на https://openrouter.ai/keys и хранится ТОЛЬКО здесь.
# Не публикуйте его: файл .env не попадает в Git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=2
OPENROUTER_MAX_TOKENS=1500
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Obeshchanie protiv realnosti

# --- Render / Neon (production) ---
# DATABASE_URL: pooled connection string от Neon (с -pooler в хосте)
# Пример: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/obeshchanie?sslmode=require
# SECRET_KEY: сгенерируйте python -c "import secrets; print(secrets.token_urlsafe(48))"
# CORS_ORIGINS: публичный URL frontend на Render (например, https://obeshchanie-frontend.onrender.com)
# LLM_PROVIDER=mock (на Render Free нет Ollama)
# STORAGE_DIR=/tmp/storage (непостоянное, файлы пропадут при редеплое)

# --- Локальная конфигурация (.env.local) ---
# Создайте файл .env.local (не коммитится в Git) для запуска backend напрямую
# через uvicorn на локальном PostgreSQL с Ollama:
#
# DATABASE_URL=postgresql+psycopg://oapv_app:oapv_local_dev@localhost:5432/obeshchanie
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
#
# Приоритет загрузки: .env -> .env.local -> переменные окружения
# Переменные окружения имеют наивысший приоритет.
